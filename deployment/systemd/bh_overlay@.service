[Unit]
Description=BH-Overlay paper runner (%i) — BTC spot + drawdown stop + vol-target fallback
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
Group=botuser
WorkingDirectory=/opt/trading-bot
Environment=PYTHONUNBUFFERED=1
# Per-instance env file is optional — paper mode needs no credentials. The
# leading `-` makes the unit loadable before any env file exists.
EnvironmentFile=-/etc/trading-bot/bh_overlay-%i.env
ExecStart=/usr/bin/python3 -m scripts.bh_overlay_runner --loop --config /opt/trading-bot/configs/bh_overlay-%i.json
Restart=on-failure
RestartSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bh_overlay-%i

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/trading-bot

[Install]
WantedBy=multi-user.target
