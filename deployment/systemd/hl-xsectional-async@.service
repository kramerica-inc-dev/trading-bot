[Unit]
Description=Event-driven async momentum runner on Hyperliquid (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
Group=botuser
WorkingDirectory=/opt/trading-bot
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/trading-bot/hl-xsectional-%i.env
ExecStart=/usr/bin/python3 -m scripts.hl_runner_async --loop --config /opt/trading-bot/configs/hl-xsectional-%i.json --interval-sec 3600
Restart=on-failure
RestartSec=30

# Async runner: asyncio loop + websocket-client thread + 2 small thread pools.
# Slightly higher ceiling than the sync runner (still numpy-steady, ~120-180MB).
MemoryHigh=384M
MemoryMax=512M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hl-xsectional-async-%i

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/trading-bot

[Install]
WantedBy=multi-user.target
