[Unit]
Description=Crypto Trader Dashboard
After=network.target

[Service]
Type=simple
User=botuser
Group=botuser
WorkingDirectory=/opt/trading-bot
Environment=BOT_DIR=/opt/trading-bot
Environment=DASHBOARD_PORT=8080
ExecStart=/usr/bin/python3 /opt/trading-bot/scripts/dashboard_api.py
Restart=always
RestartSec=5

# Cap RAM so one runaway process is cgroup-killed instead of OOM-reaping the
# whole LXC. MemoryHigh throttles+reclaims first; MemoryMax is the hard ceiling.
MemoryHigh=192M
MemoryMax=256M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=trading-dashboard

# The dashboard runs `sudo -n systemctl start/stop/restart <unit>` for service
# control (POST /api/control, with an allowlist + token + cooldown). sudo is
# setuid, so NoNewPrivileges=true would block it and break the control buttons —
# must stay false.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/trading-bot

[Install]
WantedBy=multi-user.target
